# npm start creates .env and a random JWT_SECRET automatically.
API_PORT=3000
CLIENT_PORT=3001
JWT_SECRET=
JWT_TTL_SECONDS=3600
OAUTH_TTL_SECONDS=900
# These are local classroom demo accounts, seeded only when missing.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPass123!
MEMBER_USERNAME=member
MEMBER_PASSWORD=MemberPass123!
