    {
      "name": "03 - Protect: 3 APIs with JWT",
      "item": [
        {
          "name": "API 4 - My profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/protect/profile",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "API 5 - My bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/protect/bookings",
            "description": "",
