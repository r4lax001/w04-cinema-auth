        {
          "name": "Revoke cinema-partner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{base_url}}/oauth/revoke",
            "description": "ยกเลิก Token ที่คัดลอกมา ไม่คืน response body",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "cinema-partner",
                  "type": "text"
                },
                {
                  "key": "token",
                  "value": "{{partner_access_token}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Revoke cinema-office",
          "request": {
            "method": "POST",
