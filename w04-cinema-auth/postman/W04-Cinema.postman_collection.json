{
  "info": {
    "name": "W04 Cinema - JWT and OAuth",
    "description": "API 9 ตัวตามโจทย์ (Public 3, Protect 3, Private 3). ไม่มี test script หรือผลทดสอบล่วงหน้า.\n\nเริ่ม npm start แล้วตั้งตัวแปร collection: jwt_token จาก /login; partner_access_token และ office_access_token จาก http://localhost:3001 ในแต่ละโหมด. ใส่เฉพาะค่า token ไม่ต้องใส่ Bearer.\n\nProtect ในโฟลเดอร์ 03 และ 04 คือ endpoint เดียวกัน เพียงใช้ Token คนละประเภท จึงไม่ได้นับเป็น 6 APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "partner_access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "office_access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Register and Login",
      "item": [
        {
          "name": "Register new member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/register",
            "description": "ชื่อใหม่ได้ 201; ชื่อซ้ำได้ 409. คัดลอก token ที่ได้รับไปที่ Collection Variable jwt_token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student01\",\n  \"password\": \"StudentPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/login",
            "description": "คัดลอก token จาก response ไปที่ jwt_token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"member\",\n  \"password\": \"MemberPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login admin (JWT only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/login",
            "description": "JWT admin ใช้ Protect ได้ แต่ Private ต้องใช้ OAuth Office",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"AdminPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
